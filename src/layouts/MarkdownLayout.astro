---
import Layout from '~/layouts/BaseLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import SupportBlock from '~/components/SupportBlock.astro';
import Breadcrumb from '~/components/common/Breadcrumb.astro';
import AIShare from '~/components/common/AIShare.astro';
import ShareLinks from '~/components/common/ShareLinks.astro';
import { getContentDates } from '~/utils/content-dates';
import { MetaSEO } from '~/types';
import { getImageUrl } from '~/utils/r2-images';

export interface Props {
  section?: {
    label: string;
    href: string;
  };
  ogType?: 'article' | 'website';
  // Render the support block where the rehype-sponsor-slot marker sits (after the 2nd paragraph)
  // instead of at the end of the content.
  inlineSponsor?: boolean;
}

const { frontmatter, section, ogType = 'article', inlineSponsor = false } = Astro.props;

// With `inlineSponsor`, render the body to a string and split it at the marker that
// src/utils/rehype-sponsor-slot.mjs inserted, so the Astro SupportBlock can sit mid-article.
// No marker (e.g. an unexpected content type) means the block falls back to the end.
const SPONSOR_MARKER = /<div data-sponsor-slot(?:="")?><\/div>/;
let bodyBefore = '';
let bodyAfter = '';
if (inlineSponsor) {
  const rendered = await Astro.slots.render('default');
  const match = SPONSOR_MARKER.exec(rendered);
  bodyBefore = match ? rendered.slice(0, match.index) : rendered;
  bodyAfter = match ? rendered.slice(match.index + match[0].length) : '';
}

// Generate breadcrumb items. `section` (e.g. 'Blog') inserts a middle level for content
// types; pages with no section (cv/community/contact) still get a plain Home > Title trail.
const breadcrumbItems = frontmatter?.title
  ? [
      { label: 'Home', href: '/' },
      ...(section ? [{ label: section.label, href: section.href }] : []),
      { label: frontmatter.title },
    ]
  : null;
// Resolve the social-share (Open Graph / Twitter) image from frontmatter.
// - R2 paths (e.g. "articles/foo.png") and full URLs resolve to absolute URLs.
// - Imported local assets (objects with `.src`) are passed through for MetaTags to handle.
// - Bare `/src/...` source paths aren't web-resolvable, so we omit them and let
//   MetaTags fall back to the site default image.
const fmImage = frontmatter?.image;
let ogImage: string | { src: string } | undefined;
if (typeof fmImage === 'string') {
  if (!fmImage.startsWith('/src/')) {
    ogImage = getImageUrl(fmImage);
  }
} else if (fmImage && typeof fmImage.src !== 'undefined') {
  ogImage = fmImage;
}

const dates = getContentDates(frontmatter);
const publishedDate = dates.publishedDate ? new Date(dates.publishedDate) : undefined;
const modifiedDate = dates.modifiedDate ? new Date(dates.modifiedDate) : undefined;
const formatLongDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const showUpdated = !!modifiedDate;
const updateNote: string | undefined = showUpdated ? frontmatter?.updateNote : undefined;

const meta: MetaSEO = {
  title: frontmatter?.title,
  description: frontmatter?.summary || frontmatter?.description || frontmatter?.title,
  image: ogImage,
  publication_url: frontmatter?.publication_url,
  openGraph: ogType === 'article'
    ? {
        type: 'article',
        article: {
          publishedTime: publishedDate?.toISOString(),
          modifiedTime: (modifiedDate ?? publishedDate)?.toISOString(),
          authors: frontmatter?.author ? [frontmatter.author] : undefined,
          tags: frontmatter?.tags,
          section: frontmatter?.categories?.[0],
        },
      }
    : {
        type: 'website',
      },
};

const shareUrl = frontmatter?.publication_url || Astro.url.href;
const shareSummary = frontmatter?.summary || frontmatter?.description;
---

<Layout {meta}>
  <slot name="head" slot="head" />
  <Announcement />
  <Header />

  <main id="main-content">
    <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
      {breadcrumbItems && <Breadcrumb items={breadcrumbItems} />}
      <h1 class="font-bold font-heading text-2xl sm:text-3xl md:text-4xl leading-tight md:leading-tighter tracking-normal md:tracking-tighter">{frontmatter.title}</h1>
      {publishedDate && (
        <p class="text-gray-600 dark:text-gray-400 mt-2">
          Published on {formatLongDate(publishedDate)}
          {frontmatter.author && ` by ${frontmatter.author}`}
          {showUpdated && modifiedDate && (
            <>
              {' · '}
              <span>Updated <time datetime={modifiedDate.toISOString().slice(0, 10)}>{formatLongDate(modifiedDate)}</time></span>
            </>
          )}
        </p>
      )}
      {!publishedDate && showUpdated && modifiedDate && (
        <p class="text-gray-600 dark:text-gray-400 mt-2">
          Updated <time datetime={modifiedDate.toISOString().slice(0, 10)}>{formatLongDate(modifiedDate)}</time>
        </p>
      )}
      {updateNote && (
        <p class="text-gray-600 dark:text-gray-400 mt-1 text-sm">
          <strong class="font-semibold">What changed:</strong> {updateNote}
        </p>
      )}
      {Astro.slots.has('image') && (
        <>
          <div class="mt-8">
            <slot name="image" />
          </div>
          <ShareLinks title={frontmatter.title} url={shareUrl} summary={shareSummary} class="mt-4" />
        </>
      )}
      <div
        class="mx-auto prose prose-sm sm:prose-base lg:prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-normal md:prose-headings:leading-tighter prose-headings:tracking-normal md:prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-img:rounded-md prose-img:shadow-lg mt-8"
      >
        {inlineSponsor ? (
          <>
            <Fragment set:html={bodyBefore} />
            <SupportBlock />
            <Fragment set:html={bodyAfter} />
          </>
        ) : (
          <>
            <slot />
            <SupportBlock />
          </>
        )}
      </div>
    </section>
  </main>
  {!Astro.slots.has('image') && (
    <ShareLinks
      title={frontmatter.title}
      url={shareUrl}
      summary={shareSummary}
      class="px-4 pb-8 sm:px-6 mx-auto lg:px-8 max-w-4xl"
    />
  )}
  <AIShare
    url={Astro.url.href}
    title={frontmatter.title}
    frontmatter={frontmatter}
  />
  <Footer />
</Layout>
