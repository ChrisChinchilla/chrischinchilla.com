---
import Layout from '~/layouts/BaseLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';
import Breadcrumb from '~/components/common/Breadcrumb.astro';
import ContentImage from '~/components/common/ContentImage.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ShareLinks from '~/components/common/ShareLinks.astro';
import { Icon } from 'astro-icon/components';
import { YouTube } from '@astro-community/astro-embed-youtube';
import truncateMarkdown from 'markdown-truncate';
import type { MetaSEO } from '~/types';
import { SITE } from '~/config.mjs';
import techLoungeImage from '../assets/images/tech-lounge.png';
import { getPodcastEpisodeTitle } from '~/utils/podcast-feed';

export interface Props {
  podcast: {
    title: string | string[];
    enclosure: {
      att_url: string;
    };
    image?: {
      att_href?: string;
    } | null;
    description: string;
    pubDate?: string;
  };
  /** Frontmatter of the episode's content stub (summary, tags, modifiedDate, ...), if any. */
  episodeData?: {
    summary?: string;
    youtubeId?: string;
    tags?: string[];
    modifiedDate?: Date | string;
    updateNote?: string;
  };
  /** Raw Markdown of the condensed Q&A, used for the plain-text JSON-LD `text`. */
  qaBody?: string;
  QaContent?: any;
  qaHeadings?: { depth: number; slug: string; text: string }[];
}

const { podcast, episodeData, qaBody, QaContent, qaHeadings = [] } = Astro.props;
const hasQa = Boolean(QaContent);
const qaTopics = qaHeadings.filter((h) => h.depth === 3);
const qaText = qaBody
  ?.replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[*_`#>]+/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const modifiedDate = episodeData?.modifiedDate ? new Date(episodeData.modifiedDate) : undefined;
const formatDate = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });

// Tech Lounge listings. The RSS feed works in any podcast app, so it is the universal fallback.
const FEED_URL = 'https://feeds.simplecast.com/whlwDbyc';
const subscribeLinks = [
  { label: 'Apple Podcasts', href: 'https://podcasts.apple.com/us/podcast/tech-lounge/id1071207052', icon: 'simple-icons:applepodcasts' },
  { label: 'Spotify', href: 'https://open.spotify.com/show/4esINQS7W6emShb6fwt5Vr', icon: 'simple-line-icons:social-spotify' },
  { label: 'Pocket Casts', href: 'https://pca.st/nNqR', icon: 'simple-icons:pocketcasts' },
  { label: 'RSS feed', href: FEED_URL, icon: 'tabler:rss' },
];
// sub_confirmation=1 only has an effect on channel URLs, not watch?v= links.
const channelSubscribeUrl = 'https://www.youtube.com/channel/UCgnrx8qi4qhmN6sBebdDrmg?sub_confirmation=1';
const linkClass = 'inline-flex items-center gap-1.5 hover:text-primary transition ease-in duration-200';

const episodeTitle = getPodcastEpisodeTitle(podcast);

const urlParams = new URLSearchParams(podcast.enclosure.att_url);
const podcastID = urlParams.get('awEpisodeId')
const canonical = new URL(Astro.url.pathname, SITE.origin).toString();
const meta: MetaSEO = {
  title: episodeTitle,
  image: podcast.image?.att_href,
  // TODO: Switch to using manual FM override
  description: episodeData?.summary ?? truncateMarkdown(podcast.description, { limit: 400, ellipsis: true }),
  canonical,
  ogType: 'article',
};

// Generate breadcrumb items
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Podcast', href: '/podcast' },
  { label: episodeTitle },
];
---

<Layout {meta}>
  <Fragment slot="head">
    <StructuredData type="PodcastEpisode" data={{
      title: episodeTitle,
      description: episodeData?.summary ?? podcast.description,
      image: podcast.image?.att_href,
      keywords: episodeData?.tags,
      modifiedDate: episodeData?.modifiedDate,
      text: qaText,
      videoId: episodeData?.youtubeId,
      audioUrl: podcast.enclosure?.att_url,
      pubDate: podcast.pubDate,
      canonical,
    }} />
  </Fragment>
  <Announcement />
  <Header />
  <main id="main-content">
    <section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
      <Breadcrumb items={breadcrumbItems} />
      <h1 class="font-bold font-heading text-3xl md:text-4xl leading-tighter tracking-tighter">{episodeTitle}</h1>
      <div
        class="mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-md prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-img:rounded-md prose-img:shadow-lg mt-8"
      >
        <article class="max-w-md mx-auto md:max-w-none grid gap-6 md:gap-8 md:grid-cols-2">
          <div class="min-w-0">
            <div class="relative h-0 pb-[75%] md:pb-[100%] lg:pb-[75%] overflow-hidden rounded drop-shadow-lg">
              <ContentImage
                src={podcast.image ? podcast.image.att_href : techLoungeImage}
                alt={episodeTitle}
                type="podcast"
                width={420}
                height={420}
                quality={80}
                format="png"
                loading="eager"
                decoding="async"
                class="absolute object-contain h-full rounded drop-shadow-lg"
              />
            </div>
            <ShareLinks
              title={episodeTitle}
              url={canonical}
              summary={truncateMarkdown(podcast.description, { limit: 200, ellipsis: true })}
              class="mt-4"
            />
            <div class="mt-6">
              <h2 class="text-xl sm:text-2xl leading-tight mb-2 font-heading">Listen and download</h2>
              {podcastID ?
              <iframe
                title={`Simplecast audio player for podcast episode: ${episodeTitle}`}
                height="200px"
                width="100%"
                style="border: none; overflow: hidden;"
                seamless
                src={`https://player.simplecast.com/${podcastID}`}
              ></iframe>
              : <audio controls src={podcast.enclosure.att_url} preload="none"></audio>
          }
              <nav aria-label="Subscribe to the Tech Lounge podcast" class="mt-3 text-sm not-prose">
                <p class="mb-1 font-medium">Subscribe to the podcast</p>
                <ul class="flex flex-wrap gap-x-4 gap-y-1">
                  {subscribeLinks.map((l) => (
                    <li>
                      <a href={l.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                        <Icon name={l.icon} class="w-5 h-5" aria-hidden="true" />
                        <span class="underline">{l.label}</span><span class="sr-only"> (opens in a new tab)</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <p class="mt-1 text-gray-600 dark:text-gray-400">
                  Or search for &ldquo;Tech Lounge&rdquo; in your podcast app, or paste the RSS feed address into it.
                </p>
              </nav>
            </div>
            {episodeData?.youtubeId && (
              <section aria-labelledby="video-heading" class="mt-6">
                <h2 id="video-heading" class="text-xl sm:text-2xl leading-tight mb-2 font-heading">Watch the episode</h2>
                <div class="overflow-hidden rounded drop-shadow-lg not-prose">
                  <YouTube id={episodeData.youtubeId} title={episodeTitle} playlabel={`Play video: ${episodeTitle}`} posterQuality="max" />
                </div>
                <p class="mt-3 text-sm not-prose">
                  <a href={channelSubscribeUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
                    <Icon name="tabler:brand-youtube" class="w-5 h-5" aria-hidden="true" />
                    <span class="underline">Subscribe to my channel</span><span class="sr-only"> on YouTube (opens in a new tab)</span>
                  </a>
                </p>
              </section>
            )}
          </div>

          <div class="mt-2">
                        {hasQa && (
              <p class="my-2">
                <a href="#qa-heading" class="font-medium">Skip to the condensed Q&amp;A</a>
              </p>
            )}
            <!-- TODO: Improve this -->
            <div class="my-2" set:html={truncateMarkdown(podcast.description, { limit: 2000, ellipsis: true })} />
          </div>
        </article>
      </div>

      {hasQa && (
        <section
          aria-labelledby="qa-heading"
          class="mt-12 mx-auto prose prose-lg max-w-4xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary-600 dark:prose-a:text-primary-400 prose-img:rounded-md"
        >
          <h2 id="qa-heading" class="scroll-mt-24">Condensed Q&amp;A</h2>
          {modifiedDate && (
            <p class="text-sm text-gray-600 dark:text-gray-400">
              Updated <time datetime={modifiedDate.toISOString().split('T')[0]}>{formatDate(modifiedDate)}</time>
              {episodeData?.updateNote && <> &mdash; {episodeData.updateNote}</>}
            </p>
          )}
          {qaTopics.length > 2 && (
            <nav aria-label="Q&A contents" class="not-prose my-6 rounded border border-gray-300 dark:border-gray-600 p-4">
              <p class="font-heading font-bold mb-2">In this Q&amp;A</p>
              <ul class="list-disc pl-5 space-y-1">
                {qaTopics.map((h) => (
                  <li><a href={`#${h.slug}`} class="text-primary-600 dark:text-primary-400 underline">{h.text}</a></li>
                ))}
              </ul>
            </nav>
          )}
          <QaContent />
        </section>
      )}
    </section>

  </main>

  <Footer />
</Layout>
