---
import Layout from '~/layouts/PageLayoutNoBG.astro';
import { Pagination } from 'accessible-astro-components';
import Headline from '~/components/blog/Headline.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import Newsletter from '~/components/Newsletter.astro';
import { getEntryHref } from '~/utils/content-categories';
import { getCollection } from 'astro:content';
export async function getStaticPaths({ paginate }) {
  let allNewsletters = await getCollection('newsletters');
allNewsletters = allNewsletters.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

  return paginate(allNewsletters, {
    pageSize: 25,
  });
}

const { page } = Astro.props;
const meta = {
  title: 'Newsletter',
  description: 'My roughly fortnightly newsletter.',
  // canonical: post.canonical || url,
  // image: await findImage(post.image),
  // noindex: BLOG?.post?.noindex,
  // ogType: 'article',
};

const itemListData = {
  name: 'Newsletters',
  description: meta.description,
  items: page.data.map((newsletter) => ({
    name: newsletter.data.title,
    url: getEntryHref(newsletter),
  })),
};
---

<Layout {meta}>
  <StructuredData slot="head" type="ItemList" data={itemListData} />
  <section class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
    <Headline subtitle={meta.description}>
      {meta.title}
    </Headline>
    <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
      {page.data.map((newsletter) => <Newsletter newsletter={newsletter} />)}
    </div>
    <Pagination
      firstPage={page.url.prev ? '/newsletter' : null}
      previousPage={page.url.prev ? page.url.prev : null}
      nextPage={page.url.next ? page.url.next : null}
      lastPage={page.url.next ? `/newsletter/${Math.round(page.total / page.size)}` : null}
      currentPage={page.currentPage}
      totalPages={Math.round(page.total / page.size)}
    />
  </section>
</Layout>
