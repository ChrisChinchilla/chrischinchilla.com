---
import MarkdownPostLayout from '../../layouts/MarkdownLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { getCollection, render } from 'astro:content';
import ContentImage from '~/components/common/ContentImage.astro';
import defaultPostImage from '/src/assets/images/defaults/book-chinchilla.jpg';
import Link from '../../components/Link.astro';
import { getCanonical } from '~/utils/permalinks';

export async function getStaticPaths() {
  const newsletterEntried = await getCollection('newsletters');
  return newsletterEntried.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

let links = [];

try {
  links = await fetch(`https://api.raindrop.io/rest/v1/raindrops/45559645?sort=-created&search=${entry.id}`, {
    method: 'GET',
    headers: {
    Authorization: `Bearer ${import.meta.env.RAINDROP}`,
    },
  })
    .then((response) => response.json())
    .then((response) =>
      Object.values(response.items).filter((item) => {
        const createdDate = new Date(item.created);
        return createdDate <= entry.data.date;
      })
    );
} catch (error) {
  console.warn('Unable to fetch newsletter links during build:', error);
}

const structuredData = {
  title: entry.data.title,
  description: entry.data.summary,
  publishDate: entry.data.date,
  image: entry.data.image,
  canonical: entry.data.publication_url || getCanonical(`/newsletter/${entry.id}`),
};
---

<MarkdownPostLayout frontmatter={entry.data} section={{ label: 'Newsletter', href: '/newsletter' }}>
  <StructuredData slot="head" type="CreativeWork" data={structuredData} />
  <ContentImage
    slot="image"
    src={entry.data.image}
    alt={entry.data.title}
    type="newsletter"
    class="object-contain h-full mb-6 rounded drop-shadow-lg"
  />

  <Content />
  <div>
    {
      links.map((link) => (
        <div class="mb-12 md:mb-20">
          <Link link={link} />
        </div>
      ))
    }
  </div>
</MarkdownPostLayout>
