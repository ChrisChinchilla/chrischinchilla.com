---
import { SITE } from "~/config.mjs";
import Layout from "~/layouts/PageLayout.astro";

import HeroBGImg from "~/components/widgets/HeroBGImg.astro";
import Features2 from "~/components/widgets/Features2.astro";
import LatestPosts from "~/components/blog/LatestPosts.astro";
import HighlightedPosts from "~/components/blog/HighlightedPosts.astro";
import CallToAction from "~/components/widgets/CallToAction.astro";
import Note from "~/components/widgets/Note.astro";
import StructuredData from "~/components/common/StructuredData.astro";

const meta = {
  title: SITE.title,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

// Confirmed profile URLs sourced from the codebase (Footer.astro's social links,
// MetaTags.astro's Twitter handle) rather than guessed.
const personData = {
  sameAs: [
    'https://github.com/chrischinchilla',
    'https://www.youtube.com/channel/UCgnrx8qi4qhmN6sBebdDrmg',
    'https://twitter.com/chrischinch',
  ],
};
---

<Layout {meta}>
  <StructuredData slot="head" type="Person" data={personData} />
  <StructuredData slot="head" type="WebSite" />
  <!-- Hero Widget ******************* -->
  <!-- TODO: Parameterise -->
  <HeroBGImg callToAction={{ text: "What do I do?", href: "#features2" }}>
    <!-- TODO: Parameterise -->
    <Fragment slot="title"> I am Chris Chinchilla 👋 </Fragment>
    <!-- TODO: Parameterise -->
    <Fragment slot="subtitle">

      Tech writer | Podcaster | Video maker | Journalist | Developer | Author | Games designer | Enthusiastic amateur generalist

    </Fragment>
  </HeroBGImg>
  <HighlightedPosts title="Highlights" />

  <!-- Features Widget *************** -->

  <!-- Content Widget **************** -->

  <!-- Content Widget **************** -->

  <!-- Steps Widget ****************** -->

  <!-- Features2 Widget ************** -->
  <Features2
    title="Here's what I love most"
    subtitle="Yes, I am an enthusiastic amateur about many things, but these are the things I do most often."
    items={[
      {
        title: "Tech",
        description:
          "Writing, video, and podcasts about technology. My open and close-source apps, extensions, and plugins.",
        icon: "ph:code-bold",
        permalink: "/tech",
      },
      {
        title: "Writing",
        description:
          "Writing, video, and podcasts about the art and techniques of writing. My fiction, non-fiction, apps, extensions, and plugins aimed at writers.",
        icon: "ph:pencil-circle-bold",
        permalink: "/writing",
      },
      {
        title: "Music",
        description:
          "Writing, video, and podcasts about and creating music. Releases and performance work from the bands and projects I've played in.",
        icon: "ph:music-notes-bold",
        permalink: "/music",
      },
      {
        title: "Games",
        description:
          "Writing, video, and podcasts about and creating and playing games. Download, buy, and play games I created or contributed to.",
        icon: "ph:dice-six-bold",
        permalink: "/games",
      }
    ]}
  />

  <!-- Note Widget ******************* -->

  <Note />
  <!-- <LatestPosts /> -->

  <!-- FAQs Widget ******************* -->

  <!-- Stats Widget ****************** -->

  <!-- CallToAction Widget *********** -->

  <CallToAction
    callToAction={{
      text: "View archive",
      href: "https://chinchillasqueaks.substack.com",
      icon: "tabler:download",
    }}
  >
    <Fragment slot="title">
      Join my mailing list
      <iframe
        src="https://chinchillasqueaks.substack.com/embed"
        width="480"
        height="320"
        style="border:1px solid #EEE; background:white;"
        frameborder="0"
        scrolling="no"></iframe>
    </Fragment>
  </CallToAction>
</Layout>
