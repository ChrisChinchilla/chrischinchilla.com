---
import Layout from '~/layouts/PageLayoutNoBG.astro';
import { Pagination } from 'accessible-astro-components';
import Headline from '~/components/blog/Headline.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Gear from '~/components/Gear.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  let allGear = await getCollection('gear');
  allGear = allGear.sort((a, b) => a.data.title.localeCompare(b.data.title));

  return paginate(allGear, {
    pageSize: 30,
  });
}

const { page } = Astro.props;

const meta = {
  title: 'Gear',
  description: 'The hardware and software I use for content creation, music production, and other work. Contains affiliate links.',
};

const itemListData = {
  name: 'Gear',
  description: meta.description,
  items: page.data.map((gear) => ({
    name: gear.data.title,
    url: `/gear/${gear.id}`,
  })),
};
---

<Layout {meta}>
  <StructuredData slot="head" type="ItemList" data={itemListData} />
  <section class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
    <Headline subtitle={meta.description}>
      {meta.title}
    </Headline>
    <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
      {page.data.map((gear) => <Gear gear={gear} />)}
    </div>
    <Pagination
      firstPage={page.url.prev ? '/gear' : null}
      previousPage={page.url.prev ? page.url.prev : null}
      nextPage={page.url.next ? page.url.next : null}
      lastPage={page.url.next ? `/gear/${Math.round(page.total / page.size)}` : null}
      currentPage={page.currentPage}
      totalPages={Math.round(page.total / page.size)}
    />
  </section>
</Layout>
