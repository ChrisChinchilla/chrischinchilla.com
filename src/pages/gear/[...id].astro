---
import MarkdownPostLayout from '../../layouts/MarkdownLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { getCollection, render } from 'astro:content';
import { getCanonical } from '~/utils/permalinks';

export async function getStaticPaths() {
  const gearEntries = await getCollection('gear');
  return gearEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const structuredData = {
  title: entry.data.title,
  description: entry.data.summary,
  canonical: getCanonical(`/gear/${entry.id}`),
  tags: entry.data.tags,
};
---

<MarkdownPostLayout frontmatter={entry.data} section={{ label: 'Gear', href: '/gear' }} ogType="website">
  <StructuredData slot="head" type="CreativeWork" data={structuredData} />
  <Content />
  {entry.data.affiliate_url && (
    <p class="mt-6">
      <a
        href={entry.data.affiliate_url}
        class="text-primary hover:underline"
        target="_blank"
        rel="noopener noreferrer nofollow"
      >
        Buy / Learn more →
      </a>
    </p>
  )}
</MarkdownPostLayout>
