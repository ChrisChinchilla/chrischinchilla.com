---
import Layout from '~/layouts/PageLayoutNoBG.astro';
import Headline from '~/components/blog/Headline.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { PODCAST } from '~/config.mjs';
import Podcast from '~/components/Podcast.astro';
import { Pagination } from 'accessible-astro-components';
import Content from '~/components/widgets/Content.astro';
import { slugify } from '~/utils/slugify';
import { getAllPodcastEpisodes, type PodcastEpisode } from '~/utils/podcast-feed';
import showImage from '../../assets/images/tech-lounge.png';
import type { GetStaticPaths, Page } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allEpisodes = await getAllPodcastEpisodes();

  return paginate(allEpisodes, {
    pageSize: PODCAST.postsPerPage,
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<PodcastEpisode> };
const meta = {
  title: 'Tech Lounge podcast',
  description: 'Every two weeks, the tech lounge invites tech luminaries, entrepreneurs, and creatives from small scrappy startups and open source enthusiasts to those working in large global companies. If you\'re interested in deep and creative technology and conversations with some of its most interesting practitioners, this is the show for you. Come in and get yourself comfortable.',
  image: showImage,
};

const itemListData = {
  name: meta.title,
  description: meta.description,
  items: page.data.map((episode) => {
    const title = Array.isArray(episode.title) ? episode.title[0] : episode.title;
    return {
      name: title,
      url: `/podcast/${slugify(title)}`,
    };
  }),
};
---

<Layout {meta}>
  <StructuredData slot="head" type="ItemList" data={itemListData} />
  <section class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
    <Headline>
      {meta.title}
    </Headline>
    <Content
      isReversed
      content={meta.description}
      items={[
      {
        link: 'https://open.spotify.com/show/4esINQS7W6emShb6fwt5Vr',
          icon: 'simple-line-icons:social-spotify'
      },
      {
        link: 'https://podcasts.apple.com/us/podcast/chinchilla-squeaks/id1071207052',
          icon: 'simple-icons:applepodcasts'
      },
      {
        link: 'https://podcasters.amazon.com/podcasts/0b519ff4-1afe-4b46-8873-f38b51405f89',
          icon: 'simple-icons:amazonmusic'
      },
      {
        link: 'https://pca.st/nNqR',
          icon: 'simple-icons:pocketcasts'
      },
    ]}
    image={{
      src: showImage,
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
    <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
      {page.data.map((episode) => <Podcast podcast={episode} />)}
    </div>

    <Pagination
      firstPage={page.url.prev ? '/podcast' : null}
      previousPage={page.url.prev ? page.url.prev : null}
      nextPage={page.url.next ? page.url.next : null}
      lastPage={page.url.next ? `/podcast/${Math.round(page.total / page.size)}` : null}
      currentPage={page.currentPage}
      totalPages={Math.round(page.total / page.size)}
    />
  </section>
</Layout>
