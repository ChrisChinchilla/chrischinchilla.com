---
import MarkdownPostLayout from '../../layouts/MarkdownLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { getCollection, render } from 'astro:content';
import MusicPlayer from '~/components/MusicPlayer.astro';
import { getMusicEmbed } from '~/utils/music-embed';
import ContentImage from '~/components/common/ContentImage.astro';
import { formatShortDate } from '~/utils/utils';
import { getCanonical } from '~/utils/permalinks';

export async function getStaticPaths() {
  const musicEntries = await getCollection('music');
  return musicEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { forthcoming } = entry.data;
const buyLabel = forthcoming ? 'Pre-order in the following places:' : 'Buy a copy in the following places:';

const listenUrls = [...(entry.data.store_urls ?? []), ...(entry.data.stream_urls ?? [])].map((l) => l.url);
const embed = await getMusicEmbed(listenUrls);

const structuredData = {
  sameAs: listenUrls,
  audio: embed && { '@type': 'AudioObject', name: entry.data.title, embedUrl: embed.src },
  title: entry.data.title,
  description: entry.data.summary,
  publishDate: entry.data.release_date,
  modifiedDate: entry.data.modifiedDate,
  image: entry.data.image,
  canonical: getCanonical(`/music/${entry.id}`),
};
---

<MarkdownPostLayout frontmatter={entry.data} section={{ label: 'Music', href: '/music' }}>
  <StructuredData slot="head" type="CreativeWork" data={structuredData} />
  <ContentImage
    slot="image"
    src={entry.data.image}
    alt={entry.data.title}
    type="music"
    class="object-contain h-full mb-6 rounded drop-shadow-lg"
  />
  <div class="md:flex md:gap-8 md:items-start my-4">
    <div class="order-first mb-6 md:order-last md:mb-0 md:w-96 md:shrink-0">
      <MusicPlayer title={entry.data.title} urls={listenUrls} />
    </div>
    <div class="min-w-0 flex-1">
      {
        forthcoming && (
          <p class="my-2">
            <span class="inline-block px-2 py-0.5 text-xs font-semibold uppercase tracking-wide rounded bg-primary text-white">
              Out {formatShortDate(entry.data.release_date)}
            </span>
          </p>
        )
      }
      {
        entry.data.store_urls && (
          <>
            <b class="my-2 block">{buyLabel}</b>
            <ul class="list-disc list-inside m-2">
              {entry.data.store_urls.map((store_url) => (
                <li>
                  <a href={store_url.url}>{store_url.label}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      {
        entry.data.stream_urls && (
          <>
            <b class="my-2 block">Stream in the following places:</b>
            <ul class="list-disc list-inside m-2">
              {entry.data.stream_urls.map((stream_url) => (
                <li>
                  <a href={stream_url.url}>{stream_url.label}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <Content />
    </div>
  </div>
</MarkdownPostLayout>
