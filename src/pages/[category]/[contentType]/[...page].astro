---
import { Pagination } from 'accessible-astro-components';

import Layout from '~/layouts/PageLayoutNoBG.astro';
import Headline from '~/components/blog/Headline.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Post from '~/components/Post.astro';
import Story from '~/components/Story.astro';
import Book from '~/components/Book.astro';
import Game from '~/components/Game.astro';
import Newsletter from '~/components/Newsletter.astro';
import Music from '~/components/Music.astro';
import Course from '~/components/Course.astro';
import Podcast from '~/components/Podcast.astro';
import Software from '~/components/Software.astro';
import Video from '~/components/Video.astro';
import Content from '~/components/widgets/Content.astro';
import podcastShowImage from '~/assets/images/tech-lounge.png';
import {
  SITE_CATEGORIES,
  type CategoryContentType,
  getCategoryContentTypes,
  getCategoryTypePermalink,
  getEntryHref,
} from '~/utils/content-categories';

type RouteProps = {
  category: {
    slug: string;
    title: string;
    description: string;
  };
  contentType: CategoryContentType;
  totalEntries: number;
};

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allPaths: any[] = [];

  for (const category of SITE_CATEGORIES) {
    const contentTypes = await getCategoryContentTypes(category.slug);

    for (const contentType of contentTypes) {
      const paginatedPaths = paginate(contentType.entries, {
        params: {
          category: category.slug,
          contentType: contentType.slug,
        },
        props: {
          category,
          contentType,
          totalEntries: contentType.entries.length,
        },
        pageSize: contentType.pageSize,
      });

      allPaths.push(...paginatedPaths);
    }
  }

  return allPaths;
}

const { page, category, contentType, totalEntries } = Astro.props as {
  page: any;
  category: RouteProps['category'];
  contentType: RouteProps['contentType'];
  totalEntries: RouteProps['totalEntries'];
};

const pageBase = getCategoryTypePermalink(category.slug, contentType.slug);
const totalPages = Math.ceil(page.total / page.size);

const meta = {
  title: `${category.title}: ${contentType.label}`,
  description: `${totalEntries} ${contentType.label.toLowerCase()} items in ${category.title}.`,
};

const isGridLayout = contentType.listStyle === 'grid';
const sectionClass = isGridLayout
  ? 'px-4 py-16 mx-auto max-w-6xl lg:py-20'
  : 'px-6 sm:px-6 py-6 sm:py-6 lg:py-6 mx-auto max-w-4xl';

// Matches the header block on the real /podcast page (src/pages/podcast/[...page].astro)
// word for word, per Chris's request that /tech/podcasts look identical to /podcast.
const podcastShowDescription =
  "Every two weeks, the tech lounge invites tech luminaries, entrepreneurs, and creatives from small scrappy startups and open source enthusiasts to those working in large global companies. If you're interested in deep and creative technology and conversations with some of its most interesting practitioners, this is the show for you. Come in and get yourself comfortable.";

const podcastSubscribeLinks = [
  { link: 'https://open.spotify.com/show/4esINQS7W6emShb6fwt5Vr', icon: 'simple-line-icons:social-spotify' },
  { link: 'https://podcasts.apple.com/us/podcast/chinchilla-squeaks/id1071207052', icon: 'simple-icons:applepodcasts' },
  { link: 'https://podcasters.amazon.com/podcasts/0b519ff4-1afe-4b46-8873-f38b51405f89', icon: 'simple-icons:amazonmusic' },
  { link: 'https://pca.st/nNqR', icon: 'simple-icons:pocketcasts' },
];

const getEntryName = (entry: any): string => {
  const title = entry.data?.title ?? entry.data?.event ?? entry.id;
  return Array.isArray(title) ? title[0] : title;
};

const itemListData = {
  name: meta.title,
  description: meta.description,
  items: page.data.map((entry: any) => ({
    name: getEntryName(entry),
    url: getEntryHref(entry),
  })),
};
---

<Layout {meta}>
  <StructuredData slot="head" type="ItemList" data={itemListData} />
  <section class={sectionClass}>
    <Headline subtitle={meta.description}>
      {meta.title}
    </Headline>

    {contentType.collection === 'podcast-feed' && (
      <Content
        isReversed
        content={podcastShowDescription}
        items={podcastSubscribeLinks}
        image={{ src: podcastShowImage, alt: 'Colorful Image' }}
      >
        <Fragment slot="bg">
          <div class="absolute inset-0 bg-blue-50 dark:bg-transparent" />
        </Fragment>
      </Content>
    )}

    {
      isGridLayout ? (
        <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
          {page.data.map((entry: any) =>
            contentType.collection === 'posts' ? (
              <Post post={entry} />
            ) : contentType.collection === 'books' ? (
              <Book book={entry} />
            ) : contentType.collection === 'music' ? (
              <Music release={entry} />
            ) : contentType.collection === 'games' ? (
              <Game game={entry} />
            ) : contentType.collection === 'software' ? (
              <Software software={entry} />
            ) : contentType.collection === 'youtube' ? (
              <Video video={entry} />
            ) : (
              <Story story={entry} />
            )
          )}
        </div>
      ) : (
        <ul>
          {page.data.map((entry: any) => (
            <li class="mb-12 md:mb-20">
              {contentType.collection === 'books' && <Book book={entry} />}
              {contentType.collection === 'games' && <Game game={entry} />}
              {contentType.collection === 'newsletters' && <Newsletter newsletter={entry} />}
              {contentType.collection === 'music' && <Music release={entry} />}
              {contentType.collection === 'av' && <Course course={entry} />}
              {contentType.collection === 'podcast-feed' && <Podcast podcast={entry} />}
            </li>
          ))}
        </ul>
      )
    }

    <Pagination
      firstPage={page.url.prev ? pageBase : null}
      previousPage={page.url.prev ? page.url.prev : null}
      nextPage={page.url.next ? page.url.next : null}
      lastPage={page.url.next ? `${pageBase}/${totalPages}` : null}
      currentPage={page.currentPage}
      totalPages={totalPages}
    />
  </section>
</Layout>