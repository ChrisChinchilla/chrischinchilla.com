---
import Layout from '~/layouts/PageLayoutNoBG.astro';
import Headline from '~/components/blog/Headline.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import Client from '~/components/Client.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  let allClients = await getCollection('clients');
  allClients = allClients.sort((a, b) => (b.data.end_date ?? 0) - (a.data.end_date ?? 0));
  return paginate(allClients, {
    pageSize: 25,
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<CollectionEntry<'clients'>> };

const meta = {
  title: 'Clients',
  description: 'I\'ve worked with dozens of clients over the past 10 years. Small to large and spread across multiple industries. If you\'re looking for technical or creative text, audio, or video creation or editing: <p><a class="btn btn-primary font-btn sm:mb-0 sm:mt-6 w-80" href="contact">Get in touch</a></p>',
  // canonical: post.canonical || url,
  // image: await findImage(post.image),
  // noindex: BLOG?.post?.noindex,
  // ogType: 'article',
};

const itemListData = {
  name: 'Clients',
  items: page.data.map((client) => ({
    name: client.data.title,
    url: client.data.company_url,
  })),
};
---

<Layout {meta}>
  <StructuredData slot="head" type="ItemList" data={itemListData} />
  <section class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
    <Headline subtitle={meta.description}>
      {meta.title}
    </Headline>
    <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
      {page.data.map((client) => <Client client={client} />)}
    </div>
  </section>
</Layout>
