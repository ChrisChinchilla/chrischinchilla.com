---
import Layout from '~/layouts/PageLayoutNoBG.astro';
import { Pagination } from 'accessible-astro-components';
import { Icon } from 'astro-icon/components';
import Headline from '~/components/blog/Headline.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Event from '~/components/Event.astro';
import { getCollection } from 'astro:content';
import { EVENT, SITE } from '~/config.mjs';

export async function getStaticPaths({ paginate }) {
  const now = new Date();
  let allEvents = await getCollection('events');
  allEvents = allEvents.sort((a, b) => {
    const aUpcoming = new Date(a.data.start_date) >= now;
    const bUpcoming = new Date(b.data.start_date) >= now;
    if (aUpcoming && !bUpcoming) return -1;
    if (!aUpcoming && bUpcoming) return 1;
    // Upcoming events soonest-first, past events most-recent-first.
    return aUpcoming
      ? new Date(a.data.start_date).valueOf() - new Date(b.data.start_date).valueOf()
      : new Date(b.data.start_date).valueOf() - new Date(a.data.start_date).valueOf();
  });
  return paginate(allEvents, {
    pageSize: EVENT.postsPerPage,
  });
}
const { page } = Astro.props;

const meta = {
  title: 'Events',
  description: 'I have spoken at and reported on hundreds of events around the world.',
};

const now = new Date();
const upcoming = page.data.filter((event) => new Date(event.data.start_date) >= now);
const past = page.data.filter((event) => new Date(event.data.start_date) < now);

const eventListData = {
  events: page.data.map((event) => ({
    name: event.data.title || event.data.event,
    url: event.data.pres_url,
    startDate: event.data.start_date,
    endDate: event.data.end_date,
    venue: event.data.venue,
    type: event.data.type,
  })),
};
---

<Layout {meta}>
  <StructuredData slot="head" type="Event" data={eventListData} />
  <section class="px-4 py-16 mx-auto max-w-6xl lg:py-20">
    <Headline subtitle={meta.description}>
      {meta.title}
    </Headline>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm mb-8">
      <span>Subscribe to upcoming events:</span>
      <a
        class="inline-flex items-center gap-1 hover:text-primary transition ease-in duration-200"
        href={`${SITE.origin}/events.ics`}
      >
        <Icon name="tabler:calendar-event" class="w-4 h-4" />
        iCal feed
      </a>
      <a
        class="inline-flex items-center gap-1 hover:text-primary transition ease-in duration-200"
        href={`webcal://${SITE.origin.replace(/^https?:\/\//, '')}/events.ics`}
      >
        <Icon name="tabler:calendar-plus" class="w-4 h-4" />
        Add to calendar app
      </a>
    </div>

    {upcoming.length > 0 && (
      <div class="mb-12">
        <h2 class="text-lg font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400 mb-6">Upcoming</h2>
        <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
          {upcoming.map((event) => (
            <Event
              type={event.data.type}
              title={event.data.title}
              event={event.data.event}
              summary={event.data.summary}
              pres_url={event.data.pres_url}
              slides_url={event.data.slides_url}
              video_url={event.data.video_url}
              related_post_url={event.data.related_post_url}
              start_date={event.data.start_date}
              end_date={event.data.end_date}
              venue={event.data.venue}
            />
          ))}
        </div>
      </div>
    )}

    {past.length > 0 && (
      <div>
        <h2 class="text-lg font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400 mb-6">Past</h2>
        <div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
          {past.map((event) => (
            <Event
              type={event.data.type}
              title={event.data.title}
              event={event.data.event}
              summary={event.data.summary}
              pres_url={event.data.pres_url}
              slides_url={event.data.slides_url}
              video_url={event.data.video_url}
              related_post_url={event.data.related_post_url}
              start_date={event.data.start_date}
              end_date={event.data.end_date}
              venue={event.data.venue}
            />
          ))}
        </div>
      </div>
    )}

    <Pagination
      firstPage={page.url.prev ? '/events' : null}
      previousPage={page.url.prev ? page.url.prev : null}
      nextPage={page.url.next ? page.url.next : null}
      lastPage={page.url.next ? `/events/${Math.round(page.total / page.size)}` : null}
      currentPage={page.currentPage}
      totalPages={Math.round(page.total / page.size)}
    />
  </section>
</Layout>
