---
import { type CollectionEntry } from 'astro:content';
import ContentImage from '~/components/common/ContentImage.astro';
import { slugify } from '~/utils/slugify';
import { formatShortDate } from '~/utils/utils';
import { render } from 'astro:content';
export interface Props {
  book: CollectionEntry<"books">;
}
const { book } = Astro.props;
const { Content } = await render(book);
// const featured_image = await findImage(book.data.image);
// TODO: Why is slug broken again?

const formattedDate = formatShortDate(book.data.publish_date);
const idOfTitle = slugify(book.data.title);
---

<article class="mb-6 transition px-4">
  <div class="relative md:h-72 max-w-6xl mx-auto rounded drop-shadow-lg mb-6">
    <ContentImage
      src={book.data.image}
      alt={book.data.title}
      type="book"
      class="object-contain md:h-full mb-6 rounded drop-shadow-lg"
    />
  </div>

  <div>
    <header>
      <h2 class="text-xl sm:text-2xl font-semibold leading-tight mb-2 font-subheading" id={idOfTitle}>
        <a
              class="hover:text-primary transition ease-in duration-200"
              href=`${book.id}`
              rel="canonical"
            >
        {book.data.title}</a>
      </h2>
      <i class="my-2 block">{book.data.publisher}, {formattedDate}, {book.data.role}</i>
    </header>
    <div class="post-body body">
      <Content />
    {
      book.data.store_urls && (
        
          <b class="my-2 block">Buy a copy in the following places:</b>
          <ul class="list-disc list-inside m-2">
            {book.data.store_urls.map((store_url) => (
              <li>
                <a href={store_url.url}>{store_url.label}</a>
              </li>
            ))}
          </ul>
        
      )
          </div>
    }
  </div>
</article>
