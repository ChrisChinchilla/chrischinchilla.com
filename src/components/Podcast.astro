---
import ContentImage from '~/components/common/ContentImage.astro';
import ShareLinks from '~/components/common/ShareLinks.astro';
import { stripHtml } from '~/utils/social-share';
import { formatShortDate } from '~/utils/utils';
import { slugify } from '~/utils/slugify';
import type { PodcastEpisode } from '~/utils/podcast-feed';
import techLoungeImage from '../assets/images/tech-lounge.png';

export interface Props {
  // A raw episode object from the Simplecast RSS feed, not the `podcasts`
  // content collection (which is only a sparse metadata overlay).
  podcast: PodcastEpisode;
}
const { podcast } = Astro.props;

// For some reason one feed returns the title as a duplicate array
const podcastTitle = Array.isArray(podcast.title) ? podcast.title[0] : podcast.title;

const url = '/podcast/' + slugify(podcastTitle);
const formattedDate = formatShortDate(podcast.pubDate);

const plainSummary = stripHtml(podcast.summary || podcast.description || '');
const cardSummary = plainSummary.length > 220 ? plainSummary.slice(0, 220).trimEnd() + '…' : plainSummary;
---

<article class="mb-6 transition px-4">
  <div class="relative md:h-72 max-w-6xl mx-auto rounded drop-shadow-lg mb-6">
    <ContentImage
      src={podcast.image ? podcast.image.att_href : techLoungeImage}
      alt={podcastTitle || 'Tech Lounge'}
      type="podcast"
      width={420}
      height={420}
      quality={80}
      format="png"
      loading="lazy"
      decoding="async"
      class="object-contain md:h-full mb-6 rounded drop-shadow-lg"
    />
  </div>

  <div>
    <a
      href="/podcast"
      class="bg-gray-100 dark:bg-slate-700 inline-block mr-2 mb-2 py-0.5 px-2 font-medium"
    >
      Tech Lounge
    </a>
    <header>
      <h2 class="text-xl sm:text-2xl font-semibold leading-tight mb-2 font-subheading">
        <a class="hover:text-primary transition ease-in duration-200" href={url}>
          {podcastTitle}
        </a>
      </h2>
      {formattedDate && <i class="my-2 block">{formattedDate}</i>}
    </header>
    <div class="post-body body">
      {cardSummary}
    </div>
    <ShareLinks title={podcastTitle} url={url} summary={cardSummary} compact class="mt-2" />
  </div>
</article>
