---
import { type CollectionEntry } from 'astro:content';
import ContentImage from '~/components/common/ContentImage.astro';
import ShareLinks from '~/components/common/ShareLinks.astro';
import { formatShortDate } from '~/utils/utils';
export interface Props {
  release: CollectionEntry<"music">;
}
const { release } = Astro.props;

const formattedDate = formatShortDate(release.data.release_date);
const { forthcoming } = release.data;

const meta = [release.data.band, formattedDate, release.data.record_label, release.data.role]
  .filter(Boolean)
  .join(', ');

const buyLabel = forthcoming ? 'Pre-order in the following places:' : 'Buy a copy in the following places:';
---

<article class="mb-6 transition px-4">
  <div class="relative md:h-72 max-w-6xl mx-auto rounded drop-shadow-lg mb-6">
    <ContentImage
      src={release.data.image}
      alt={release.data.title}
      type="music"
      class="object-contain md:h-full mb-6 rounded drop-shadow-lg"
    />
  </div>

  <div>
    <header>
      <h2 class="text-xl sm:text-2xl font-semibold leading-tight mb-2 font-subheading">
        <a
          class="hover:text-primary transition ease-in duration-200"
          href={`/music/${release.id}`}
          rel="canonical"
        >
          {release.data.title}
        </a>
      </h2>
      {
        forthcoming && (
          <span class="inline-block mb-2 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide rounded bg-primary text-white">
            Out {formattedDate}
          </span>
        )
      }
      <i class="my-2 block">{meta}</i>
    </header>
    <div class="post-body body whitespace-pre-line">
      {release.data.summary}
    </div>
    {
      release.data.store_urls && release.data.store_urls.length > 0 && (
        <div class="mt-3">
          <b class="block mb-1">{buyLabel}</b>
          <ul class="list-disc list-inside">
            {release.data.store_urls.map((store_url) => (
              <li>
                <a class="hover:text-primary transition ease-in duration-200" href={store_url.url}>
                  {store_url.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      release.data.stream_urls && release.data.stream_urls.length > 0 && (
        <div class="mt-3">
          <b class="block mb-1">Stream in the following places:</b>
          <ul class="list-disc list-inside">
            {release.data.stream_urls.map((stream_url) => (
              <li>
                <a class="hover:text-primary transition ease-in duration-200" href={stream_url.url}>
                  {stream_url.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <ShareLinks title={release.data.title} url={`/music/${release.id}`} summary={release.data.summary} compact class="mt-2" />
  </div>
</article>
