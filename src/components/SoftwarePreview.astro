---
import type { CollectionEntry } from 'astro:content';
interface Props {
  software: CollectionEntry<'software'>;
  overview?: boolean;
}
const { software, overview = false } = Astro.props;
const { image, image_alt, title, status } = software.data;
---

<div class:list={['software-preview', { overview, listing: !overview, 'rounded drop-shadow-lg': !overview }]}>
  {
    image ? (
      <img
        src={image}
        alt={image_alt ?? `${title} screenshot`}
        width="1280"
        height="800"
        loading={overview ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="placeholder">
        <span class="font-subheading text-xl font-semibold">{title}</span>
        <span class="text-sm">{status ?? 'Screenshot coming soon'}</span>
      </div>
    )
  }
</div>

<style>
  .software-preview {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #e8edf3;
    color: #334155;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    background: linear-gradient(135deg, #e8edf3, #dbe8ef);
  }
  @media (min-width: 768px) {
    .listing {
      height: 18rem;
      aspect-ratio: auto;
    }
  }
  .overview {
    border-radius: 0.75rem;
  }
</style>
