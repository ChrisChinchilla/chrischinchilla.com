---
import ContentImage from '~/components/common/ContentImage.astro';
import { formatShortDate } from '~/utils/utils';
import type { HighlightedItem } from '~/utils/highlighted';

interface Props {
  item: HighlightedItem;
}

const { item } = Astro.props;
const formattedDate = item.date ? formatShortDate(item.date) : null;
---

<article class="mb-6 p-4 transition bg-white/70 dark:bg-slate-900 rounded drop-shadow-lg hover:shadow-md border border-transparent dark:border-slate-800">
  <div class="relative md:h-72 max-w-6xl mx-auto rounded drop-shadow-lg mb-6">
    <ContentImage
      src={item.image}
      alt={item.title}
      type="post"
      class="object-contain md:h-full mb-2 rounded drop-shadow-lg"
    />
  </div>

  <div>
    <header>
      <h2 class="text-xl sm:text-2xl leading-tight mb-2 font-subheading font-semibold">
        <a class="hover:text-primary transition ease-in duration-200" href={item.slug} rel="canonical">
          {item.title}
        </a>
      </h2>
      {formattedDate && <i class="my-2 block">{formattedDate}</i>}
    </header>
    <div class="post-body body whitespace-pre-line">
      {item.summary}
    </div>
  </div>
</article>
