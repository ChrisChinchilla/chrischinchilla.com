---
// import { findImage } from '~/utils/images';
export interface RaindropLink {
  title: string;
  link: string;
  note?: string;
  cover?: string;
  created: string;
}
export interface Props {
  link: RaindropLink;
}
const { link } = Astro.props;
// Default images
const src = link.cover ?? '/images/default.png';
---

<div>
  <!-- <Picture
      src={src}
      widths={[250, 400]}
      sizes="(max-width: 400px) 75vw, 200px"
      alt={title}
      aspectRatio="4:3"
      fit="inside"
    /> -->
  <img src={src} />
  <h2 class="text-xl sm:text-2xl leading-tight mb-2 font-heading">
    {link.title}
  </h2>
  <i class="my-2 block"><a href={link.link} class="cleanlink">{link.link}</a></i>
  <p class="my-2" set:html={link.note} />
</div>
