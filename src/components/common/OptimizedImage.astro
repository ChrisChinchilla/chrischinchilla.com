---
import { getImage } from 'astro:assets';
import { resolveImage } from '~/utils/image-loader';
import { getImageUrl } from '~/utils/r2-images';

export interface Props {
  src: any;
  alt: string;
  title?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'auto' | 'sync';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  format?: 'avif' | 'webp' | 'png' | 'jpg';
  quality?: number;
  inferSize?: boolean;
}

const {
  src: _src,
  alt,
  title,
  width,
  height,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
  class: className = '',
  format = 'webp',
  quality = 80,
  inferSize = true,
  ...rest
} = Astro.props;

// Resolve the image (handles R2 paths, local paths, etc.)
const src = await resolveImage(_src);

// Validate alt text exists and is meaningful
if (!alt || alt.trim() === '') {
  console.warn(`Image missing alt text: ${_src}`);
}

// Only bundled ImageMetadata is passed to Astro's optimizer. String sources
// (including R2 paths) remain remote, keeping static builds network-independent.
const optimized = typeof src === 'string' ? null : await getImage({ src, width, height, quality, format, inferSize });
---

{
  optimized ? (
    <img
      src={optimized.src}
      {...optimized.attributes}
      alt={alt}
      {title}
      class={className}
      loading={loading}
      decoding={decoding}
      fetchpriority={fetchpriority}
      {...rest}
    />
  ) : (
    <img
      src={getImageUrl(src as string)}
      alt={alt}
      {title}
      {width}
      {height}
      loading={loading}
      decoding={decoding}
      class={className}
      {...rest}
    />
  )
}
