---
/**
 * R2Image Component
 *
 * A flexible image component that supports both local Astro assets and Cloudflare R2.
 * Automatically detects the image source and handles it appropriately.
 * Local imports are optimized at build time. R2 images remain remote so local
 * builds do not depend on the bucket being reachable.
 *
 * @example Local image
 * ```astro
 * <R2Image
 *   src="/src/assets/images/logo.png"
 *   alt="Logo"
 *   width={200}
 *   height={100}
 * />
 * ```
 *
 * @example R2 image with path
 * ```astro
 * <R2Image
 *   src="posts/my-article.jpg"
 *   alt="Article hero"
 *   width={800}
 *   height={600}
 * />
 * ```
 *
 * @example R2 image with full URL
 * ```astro
 * <R2Image
 *   src="https://images.example.com/posts/hero.jpg"
 *   alt="Hero"
 *   width={1200}
 *   height={630}
 * />
 * ```
 *
 * @example With transformations
 * ```astro
 * <R2Image
 *   src="posts/large-image.jpg"
 *   alt="Optimized image"
 *   width={800}
 *   height={600}
 *   quality={80}
 *   format="webp"
 * />
 * ```
 */

import { getImage } from 'astro:assets';
import { getImageUrl } from '../../utils/r2-images';
import { resolveImage } from '../../utils/image-loader';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  quality?: number;
  format?: 'avif' | 'webp' | 'png' | 'jpg';
  class?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  inferSize?: boolean;
  [key: string]: any; // Allow additional props to pass through
}

const {
  src,
  alt,
  width,
  height,
  quality,
  format,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  inferSize,
  ...rest
} = Astro.props;

// Resolve the image - convert local paths to ImageMetadata objects
const resolvedSrc = await resolveImage(src);

// Validate alt text exists and is meaningful
if (!alt || alt.trim() === '') {
  console.warn(`Image missing alt text: ${src}`);
}

// Determine image type after resolution
// - ImageMetadata object: actual Astro import, optimize with inferSize
// - String starting with '/src/': this shouldn't happen after resolution, but handle it
// - String sources: render as plain <img> elements. In particular, keeping R2
//   images remote prevents thousands of network requests during a static build.
const isImageMetadata = typeof resolvedSrc !== 'string';
const renderedSrc = typeof resolvedSrc === 'string' ? getImageUrl(resolvedSrc) : resolvedSrc;

let optimized: Awaited<ReturnType<typeof getImage>> | null = null;
if (isImageMetadata) {
  optimized = await getImage({
    src: resolvedSrc,
    width,
    height,
    quality,
    format,
    inferSize: inferSize ?? true,
  });
}
---

{
  optimized ? (
    <img
      src={optimized.src}
      {...optimized.attributes}
      alt={alt}
      class={className}
      loading={loading}
      decoding={decoding}
      {...rest}
    />
  ) : (
    <img
      src={renderedSrc as string}
      alt={alt}
      width={width}
      height={height}
      class={className}
      loading={loading}
      decoding={decoding}
      {...rest}
    />
  )
}
