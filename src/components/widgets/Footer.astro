---
import { Icon } from 'astro-icon/components';
import { getHomePermalink, getAsset } from '~/utils/permalinks';
import { getFooterNavLinks } from '~/utils/nav-links';
import contactLinks from '~/data/contact.json';

const links = getFooterNavLinks();

const social = [{ label: 'RSS', icon: 'tabler:rss', href: getAsset('/rss.xml') }, ...contactLinks.map(({ title, image, network_link }) => ({ label: title, icon: image, href: network_link }))];
---

<footer class="border-t border-gray-200 dark:border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 sm:gap-y-3 py-4 sm:py-6 lg:py-8 xl:py-10">
      <div class="w-full lg:w-auto lg:mr-2">
        <a class="inline-block text-lg lg:text-xl" href={getHomePermalink()}>Chris Chinchilla</a>
      </div>
      {
        links.map(({ text, href }) => (
          <a class="text-gray-800 dark:text-gray-300 font-medium hover:underline text-sm lg:text-base" href={href}>
            {text}
          </a>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-3 sm:py-4 lg:py-6 xl:py-8">
      <ul class="flex flex-wrap mb-3 sm:mb-4 md:order-1 -ml-2 md:ml-4 md:mb-0">
        {
          social.map(({ label, href, icon }) => (
            <li>
              <a
                class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                aria-label={label}
                href={href}
              >
                <Icon name={icon} class="w-5 h-5" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="text-sm text-gray-700 mr-4 dark:text-slate-400">
        © Chris Chinchilla {new Date().getFullYear()}
      </div>
    </div>
  </div>
</footer>
