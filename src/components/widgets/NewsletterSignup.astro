---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getPermalink } from '~/utils/permalinks';
import { formatShortDate } from '~/utils/utils';

const archiveHref = getPermalink('/newsletter');

const newsletters = await getCollection('newsletters');
const latest = newsletters.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<section class="relative print:hidden" aria-labelledby="newsletter-signup-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="py-8 md:py-12">
      <div
        class="grid gap-6 md:grid-cols-2 md:items-center max-w-5xl mx-auto p-5 sm:p-6 md:p-8 rounded-xl bg-brandBlue/15 border border-brandBlue/40 dark:bg-slate-800/60 dark:border-slate-700"
      >
        <div class="text-center md:text-left">
          <h2
            id="newsletter-signup-heading"
            class="text-2xl sm:text-3xl leading-tighter tracking-tighter mb-3 font-subheading font-semibold"
          >
            Join my mailing list
          </h2>
          <p class="text-base text-gray-700 dark:text-slate-300 mb-4">
            My roughly fortnightly newsletter, sent via Substack.
          </p>
          {
            latest && (
              <p class="text-sm text-gray-700 dark:text-slate-300 mb-5">
                <span class="font-semibold">Latest issue:</span>{' '}
                <a class="underline hover:text-primary" href={getPermalink(`/newsletter/${latest.id}`)}>
                  {latest.data.title}
                </a>{' '}
                <span class="text-gray-600 dark:text-slate-400">({formatShortDate(latest.data.date)})</span>
              </p>
            )
          }
          <a class="btn font-btn w-full sm:w-auto" href={archiveHref}>
            <Icon name="tabler:rss" class="w-5 h-5 mr-1 -ml-1.5" aria-hidden="true" />
            View archive
          </a>
        </div>
        <!--
          Substack's official embed, the supported way to subscribe from another site. Its
          contents can't be styled, so it sits in a white card that also reads as intentional in
          dark mode. Lazy so it only loads when a reader scrolls near it.
        -->
        <div class="rounded-lg bg-white shadow-lg ring-1 ring-black/5 overflow-hidden">
          <iframe
            src="https://chinchillasqueaks.substack.com/embed"
            title="Subscribe to the Chinchilla Squeaks newsletter on Substack"
            loading="lazy"
            height="320"
            scrolling="no"
            class="block w-full h-80 border-0 bg-white"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
